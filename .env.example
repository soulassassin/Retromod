# HTTP server port (defaults to 3000; use e.g. 4101 if 3000 is already occupied)
PORT=3000

# ---------------------------------------------------------------------------
# Live stock database (Supabase). When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# are set, products, orders and photos are stored in Supabase and staff sign in
# with their own email + password. Set the same three values in Vercel
# (Project → Settings → Environment Variables) for the live site.
# Keys: Supabase dashboard → Project Settings → API Keys.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://vkjzhnhfdlwdeaiopomc.supabase.co
# Secret. Server-side only; never put it in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable / anon key (used for the staff login call).
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Offline / local-only mode (used when the Supabase values above are blank).
# ---------------------------------------------------------------------------
# Directory for runtime JSON stores (catalog.json, orders.json, import-logs.json) and uploaded /media files.
RETROMOD_DATA_DIR=
# Single shared admin password for /admin in local mode
RETROMOD_ADMIN_PASSWORD=change-me-in-production
# Optional HMAC secret for signing retromod_admin session cookies
RETROMOD_SESSION_SECRET=
