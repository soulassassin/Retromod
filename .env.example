# HTTP server port (defaults to 3000; use e.g. 4101 if 3000 is already occupied)
PORT=3000

# Directory for runtime JSON stores (catalog.json, orders.json, import-logs.json) and uploaded /media files.
# Defaults to ./data when unset.
RETROMOD_DATA_DIR=

# Admin console password (used in /admin authentication)
RETROMOD_ADMIN_PASSWORD=change-me-in-production

# Optional HMAC secret for signing retromod_admin session cookies
RETROMOD_SESSION_SECRET=
